# Copy to .env and fill in real values for local development. .env is gitignored.

# --- docker-compose (Postgres + pgvector) ---
POSTGRES_USER=almagest
POSTGRES_PASSWORD=almagest_dev
POSTGRES_DB=almagest
POSTGRES_PORT=5432

# --- docker-compose (Api container) ---
API_PORT=8080

# --- Almagest.Api / Almagest.Infrastructure ---
# Only read when running the Api directly with `dotnet run`, outside Docker.
# The compose "api" service builds its own connection string from the
# Postgres vars above (Host=db, the in-network service name) and ignores this.
ALMAGEST_CONNECTION_STRING=Host=localhost;Port=5432;Username=almagest;Password=almagest_dev;Database=almagest

# Anthropic (same variables the Lab project already reads).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Voyage AI embeddings.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4
