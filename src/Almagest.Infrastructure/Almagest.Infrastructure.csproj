<Project Sdk="Microsoft.NET.Sdk">

  <!-- Infrastructure references Application to implement its ports.
       Anthropic.SDK and Npgsql are confined to this layer. Semantic Kernel
       is no longer a dependency here (Phase 5): ClaudeChatService now uses
       IChatClient directly, same as every other Claude-calling class in
       this project; only Almagest.Lab still references it. -->
  <ItemGroup>
    <ProjectReference Include="..\Almagest.Application\Almagest.Application.csproj" />
  </ItemGroup>

